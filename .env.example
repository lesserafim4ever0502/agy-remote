# Bridge network. For a first run, keep this on loopback.
AGY_REMOTE_HOST=127.0.0.1
AGY_REMOTE_PORT=7317

# Optional fixed bearer token. If omitted, the bridge creates ~/.agy-remote/token.
# AGY_REMOTE_TOKEN=replace-with-a-long-random-token

# Antigravity metadata. Leave API key unset to auto-read Antigravity state.vscdb when possible.
# AGY_API_KEY=
AGY_IDE_VERSION=2.1.1

# Conservative by default: commands require approval and gitignored access stays disabled.
AGY_TERMINAL_POLICY=off
AGY_ARTIFACT_REVIEW_POLICY=always
AGY_ALLOW_GITIGNORED=false

# Optional manual Language Server override, useful for debugging discovery.
# AGY_LS_PORT=12345
# AGY_LS_CSRF=...
# AGY_LS_PROTOCOL=https

# Only needed when daemon discovery fails and process scanning is desired.
AGY_DISCOVERY_PROCESS_SCAN=1

# Set to 1 only when you intentionally bind the bridge outside loopback/private/Tailscale ranges.
AGY_REMOTE_ALLOW_PUBLIC_BIND=0
